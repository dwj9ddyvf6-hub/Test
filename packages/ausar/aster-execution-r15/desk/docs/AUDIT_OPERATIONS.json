  "findings": [
    {
      "id": "OPS-01",
      "severity": "high",
      "problem": "Restore accepted the main-file hash but SQLite replayed unreceipted backup WAL; source could also change between hash and second read.",
      "repair": "Hash the exact private streamed copy; verify it immutable without backup sidecars; publish exclusively only after identity and integrity pass.",
      "regressions": [
        "BackupTests.test_restore_uses_only_receipted_bytes_even_with_live_backup_wal",
        "BackupTests.test_receipted_restore_preserves_evidence_and_refuses_existing_or_modified_backup"
      ],
      "status": "repaired"
    },
    {
      "id": "OPS-02",
      "severity": "medium",
      "problem": "Destination sidecars appearing during verification were not checked before publication; backup JSON receipt directory entry was not fsynced.",
      "repair": "Recheck sidecars before exclusive hard-link publication, preserve concurrent state and clean only our temporary copy; fsync backup receipt directory.",
      "regressions": [
        "BackupTests.test_restore_refuses_sidecars_created_during_verification"
      ],
      "status": "repaired"
    },
    {
      "id": "OPS-03",
      "severity": "high",
      "problem": "Fresh heartbeat made the external monitor and Docker healthcheck pass despite degraded runtime, stalled useful work, journal gates or task worker failure.",
      "repair": "Probe lightweight /api/health and evaluate actual runtime/worker/database/journal status, timestamp validity and age. Docker uses the same check.",
      "regressions": [
        "MonitorTests.test_fresh_heartbeat_cannot_hide_runtime_gate_or_stall",
        "MonitorTests.test_health_endpoint_database_and_task_worker_failures_are_detected",
        "MonitorTests.test_paused_healthy_runtime_is_available_but_bad_timestamps_fail",
        "MonitorTests.test_invalid_monitor_age_is_rejected_before_any_http_request"
      ],
      "status": "repaired"
    },
    {
      "id": "OPS-04",
      "severity": "medium",
      "problem": "Launcher reused existing node_modules after frontend dependency lock changes, potentially building with a different dependency tree.",
      "repair": "Persist frontend lock hash after npm ci and repeat clean install only when missing or changed.",
      "regressions": [
        "LauncherTests.test_launcher_reinstalls_frontend_when_dependency_lock_changes"
      ],
      "status": "repaired"
    },
    {
      "id": "OPS-05",
      "severity": "high",
      "problem": "Per-socket transport timeouts allowed indefinitely trickling replies; asyncio.run could also wait for slow resolver executor teardown beyond the request deadline.",
      "repair": "Common cancellable async IO loop with four daemon resolver threads and four bounded work slots; total caller/request deadline includes streamed body, bounded response size and explicit redirect rules. Saturation rejects work without growing a cancelled-work queue. Timeout cancels the request; late resolver completion cannot send HTTP, and interpreter shutdown does not wait for blocked DNS. Provider/research/notification/model adapters use the same helper.",
      "regressions": [
        "HTTPTransportTests.test_total_deadline_stops_a_real_continuously_streaming_response",
        "HTTPTransportTests.test_slow_dns_does_not_extend_deadline_or_send_after_cancellation",
        "HTTPTransportTests.test_statuses_body_and_no_redirect_are_preserved",
        "HTTPTransportTests.test_read_redirects_can_be_enabled_and_non_success_status_returned",
        "HTTPTransportTests.test_response_limit_rejects_oversize_and_accepts_exact_bound",
        "HTTPTransportTests.test_invalid_bounds_do_not_make_a_request",
        "HTTPTransportTests.test_resolver_saturation_rejects_new_work_and_recovers",
        "HTTPTransportTests.test_slow_resolver_does_not_hold_interpreter_shutdown"
      ],
      "status": "repaired"
    }
  ],
