# Optional read-only reasoning for scheduled research/operational briefs.
# Local operational agents work without these values.
ASTER_LLM_BASE_URL=https://api.openai.com/v1
ASTER_LLM_MODEL=
ASTER_LLM_API_KEY=
# Enable independent risk and journal model reviews in addition to coordinator.
ASTER_LLM_MULTI_AGENT=false

# Actual public data collection; observations retain provider times/delay status.
ASTER_MARKET_DATA=yahoo
# Optional GET-only corporate-action data for the local Tensor paper books.
# This JSON file contains key/secret; keep it in ignored data/, never in Git.
# ASTER_ACTIONS_CREDENTIALS_FILE=data/alpaca-readonly-credentials.json
# Alpaca PAPER only. No live-broker URL setting exists.
ASTER_ALPACA_KEY=
ASTER_ALPACA_SECRET=
# Optional separate paper accounts; default keys above stay separate.
ASTER_ALPACA_ACCOUNTS=
# ASTER_ALPACA_RESEARCH_KEY=
# ASTER_ALPACA_RESEARCH_SECRET=
# SEC requires an identifying User-Agent, e.g. name plus contact email.
ASTER_SEC_USER_AGENT=
# Optional read-only connection to the saved repository research catalogue.
ASTER_RESEARCH_INDEX=
ASTER_RESEARCH_INTERVAL_SECONDS=3600

# Optional notification providers. External delivery stays disabled until
# explicitly enabled in Operations/Inbox; no prior events are replayed.
ASTER_NOTIFICATION_WEBHOOK_URL=
ASTER_NOTIFICATION_WEBHOOK_TOKEN=
ASTER_TYPEFULLY_API_KEY=
ASTER_TYPEFULLY_SOCIAL_SET_ID=
ASTER_VAPID_PUBLIC_KEY=
ASTER_VAPID_PRIVATE_KEY=
ASTER_VAPID_SUBJECT=

# Optional path override; default is the project's data directory.
# ASTER_DB_PATH=/absolute/path/aster.sqlite
# ASTER_PORT=8787
# ASTER_HOST=127.0.0.1

