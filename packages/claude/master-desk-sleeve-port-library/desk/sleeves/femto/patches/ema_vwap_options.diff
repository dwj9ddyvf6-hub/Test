+def _occ_parts(occ):
+    """(expiry ISO, strike) from an OCC symbol."""
+    t = str(occ)[-15:]
+    return "20%s-%s-%s" % (t[0:2], t[2:4], t[4:6]), int(t[7:]) / 1000.0
