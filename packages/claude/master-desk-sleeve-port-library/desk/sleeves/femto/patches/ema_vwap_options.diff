+def held_spread(pos):
+    """master-desk: the held spread — its legs from the book (long > 0, short < 0), its selection from the entry's
+    meta (derived from the OCCs when absent), the debit paid (the fill, to the cent as the old read its fills),
+    the contracts and the fill time. None unless exactly one long and one short leg."""
+    legs = pos.get("legs") or {}
+    longs = [o for o, q in legs.items() if float(q) > 0]
+    shorts = [o for o, q in legs.items() if float(q) < 0]
+    if len(longs) != 1 or len(shorts) != 1:
+        return None
+    sp = dict(pos.get("spread") or {})
+    net = pos.get("net_entry")
+    if not sp.get("expiry") or sp.get("max_profit") is None or sp.get("width") is None:
+        try:
+            exp, kl = _occ_parts(longs[0])
+            ks = _occ_parts(shorts[0])[1]
+        except (ValueError, IndexError):
+            return None
+        width = round(ks - kl, 2)
+        debit = round(float(net), 2) if net is not None else 0.0
+        sp = dict(sp, expiry=exp, width=width, debit=debit, max_profit=round(width - debit, 2),
+                  long_leg={"strike": kl}, short_leg={"strike": ks})
+    sp["long_leg"] = dict(sp.get("long_leg") or {}, occ=longs[0])
+    sp["short_leg"] = dict(sp.get("short_leg") or {}, occ=shorts[0])
+    return {"spread": sp, "entry_debit": round(float(net), 2) if net is not None else float(sp.get("debit") or 0),
+            "contracts": int(abs(float(pos.get("qty") or 0))), "opened_at": pos.get("opened_at")}
+
