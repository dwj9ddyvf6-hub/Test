+        bid = ask = 0.0
+    if 0 < bid <= ask and q.get("t") is not None and now - float(q["t"]) <= 900:
+        t = datetime.fromtimestamp(float(q["t"]), tz=ET)
+        if (9, 30) <= (t.hour, t.minute) < (16, 0):
+            return (bid + ask) / 2.0
+    bl = bars.get(sym) or []
+    return float(bl[-1]["c"]) if bl else None
